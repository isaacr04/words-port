<?xml version="1.0" encoding="UTF-8"?>
<!-- Peter Sonntag 2019 <peter@sonniger-tag.eu> -->
<component type="desktop-application">
  <id>org.codeberg.petsoi.wordle</id>
  <metadata_license>CC0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>
  <name>Wordle</name>
  <summary>Have fun guessing Words</summary>
  <description>
    <p>Wordle is a popular word puzzle game where players try to guess a hidden five-letter word within six attempts.</p>
    <p>It's simple yet addictive, combining logic, vocabulary, and deduction.</p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://codeberg.org/petsoi/wordle/raw/branch/main/data/resources/screenshots/main_light.png</image>
      <caption>Main window light</caption>
    </screenshot>
    <screenshot type="default">
      <image>https://codeberg.org/petsoi/wordle/raw/branch/main/data/resources/screenshots/main_dark.png</image>
      <caption>Main window dark</caption>
    </screenshot>
    <screenshot type="default">
      <image>https://codeberg.org/petsoi/wordle/raw/branch/main/data/resources/screenshots/gameover_light.png</image>
      <caption>Game Over light</caption>
    </screenshot>
    <screenshot type="default">
      <image>https://codeberg.org/petsoi/wordle/raw/branch/main/data/resources/screenshots/gameover_dark.png</image>
      <caption>Game Over dark</caption>
    </screenshot>
  </screenshots>
  <url type="homepage">https://codeberg.org/petsoi/wordle</url>
  <url type="bugtracker">https://codeberg.org/petsoi/wordle/issues</url>
  <!-- Source code repository -->
  <url type="vcs-browser">https://codeberg.org/petsoi/wordle</url>
  <!-- Translation repository -->
  <!-- <url type="translate">https://gitlab.gnome.org/bilelmoussaoui/wordle/-/tree/master/po</url> -->
  <!-- Open Age Ratings Service:
       https://hughsie.github.io/oars/generate.html
  -->
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.1.0" date="2019-07-11" />
  </releases>
  <kudos>
     <!--
       GNOME Software kudos:
       https://gitlab.gnome.org/GNOME/gnome-software/-/blob/main/doc/kudos.md
     -->
     <kudo>ModernToolkit</kudo>
     <kudo>HiDpiIcon</kudo>
  </kudos>
  <!-- developer_name tag deprecated with Appstream 1.0 -->
  <developer_name translate="no">Peter Sonntag</developer_name>
  <!-- Introduced with Appstream 1.0, but not yet fully supported by corresponding projects -->
  <developer id="gnome.org">
    <name translate="no">Peter Sonntag</name>
  </developer>
  <!-- 
    Branding colors:
    https://docs.flathub.org/docs/for-app-authors/metainfo-guidelines/#brand-color
  -->
  <branding>
    <color type="primary" scheme_preference="light">#2EC27E</color>
    <color type="primary" scheme_preference="dark">#2EC27E</color>
  </branding>  
  <update_contact>peter@sonniger-tag.eu</update_contact>
  <translation type="gettext">@gettext-package@</translation>
  <launchable type="desktop-id">org.codeberg.petsoi.wordle.desktop</launchable>
</component>
