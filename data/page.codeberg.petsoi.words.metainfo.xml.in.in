<?xml version="1.0" encoding="UTF-8"?>
<!-- Peter Sonntag 2019 <peter@sonniger-tag.eu> -->
<component type="desktop-application">
  <id>@app-id@</id>

  <metadata_license>CC0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Words!</name>
  <summary>Have fun guessing Words</summary>

  <description>
    <p>Words is a popular word puzzle game, similar to Wordle, where players try to guess a hidden word within six attempts.</p>
    <p>It's simple yet addictive, combining logic, vocabulary, and deduction.</p>
  </description>

  <screenshots>
    <screenshot type="default">
      <image type="source">https://codeberg.org/petsoi/words/raw/commit/6d570509550a9e96fee454535585b59f482b8652/data/resources/screenshots/main_light.png</image>
      <caption>Main Window, light</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://codeberg.org/petsoi/words/raw/commit/6d570509550a9e96fee454535585b59f482b8652/data/resources/screenshots/main_dark.png</image>
      <caption>Main Window, dark</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://codeberg.org/petsoi/words/raw/commit/9b2a34ac106d060546efa9a7bd81658e8a455954/data/resources/screenshots/gameover_light.png</image>
      <caption>Game Over, light</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://codeberg.org/petsoi/words/raw/commit/9b2a34ac106d060546efa9a7bd81658e8a455954/data/resources/screenshots/gameover_dark.png</image>
      <caption>Game Over, dark</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://codeberg.org/petsoi/words</url>
  <url type="bugtracker">https://codeberg.org/petsoi/words/issues</url>
  <!-- Source code repository -->
  <url type="vcs-browser">https://codeberg.org/petsoi/words</url>
  <!-- Translation repository -->
  <!-- <url type="translate">https://gitlab.gnome.org/bilelmoussaoui/words/-/tree/master/po</url> -->
  <!-- Open Age Ratings Service:
       https://hughsie.github.io/oars/generate.html
  -->
  <content_rating type="oars-1.1" />

  <recommends>
    <control>pointing</control>
    <control>touch</control>
    <control>keyboard</control>
    <control>tablet</control>
  </recommends>

  <categories>
    <category>Game</category>
  </categories>

  <keywords>
    <keyword>wordle</keyword>
  </keywords>

  <kudos>
     <!--
       GNOME Software kudos:
       https://gitlab.gnome.org/GNOME/gnome-software/-/blob/main/doc/kudos.md
     -->
     <kudo>ModernToolkit</kudo>
     <kudo>HiDpiIcon</kudo>
  </kudos>
  <!-- developer_name tag deprecated with Appstream 1.0 -->
  <developer_name translate="no">Peter Sonntag</developer_name>
  <!-- Introduced with Appstream 1.0, but not yet fully supported by corresponding projects -->
  <developer id="gnome.org">
    <name translate="no">Peter Sonntag</name>
  </developer>
  <url type="donation">https://paypal.me/KleinerOnkel</url>
  <!-- 
    Branding colors:
    https://docs.flathub.org/docs/for-app-authors/metainfo-guidelines/#brand-color
  -->
  <branding>
    <color type="primary" scheme_preference="light">#2EC27E</color>
    <color type="primary" scheme_preference="dark">#2EC27E</color>
  </branding>  

  <update_contact>peter@sonniger-tag.eu</update_contact>
  <translation type="gettext">@gettext-package@</translation>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
  
  <releases>
    <release version="0.1.1" date="2025-01-21">
      <description>
        <p>Changes:</p>
        <ul>
          <li>Fix keyboard (Z was missing).</li>
          <li>Make the default size more narrow.</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2025-01-19">
      <description>
        <p>First simple release.</p>
      </description>
    </release>
  </releases>
</component>
