<?xml version="1.0" encoding="UTF-8"?>
<!-- Peter Sonntag 2019 <peter@sonniger-tag.eu> -->
<component type="desktop-application">
    <id>@app-id@</id>
    <metadata_license>CC0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>
    <name>Words!</name>
    <summary>Have fun guessing Words</summary>
    <description>
        <p>Words is a popular word puzzle game, similar to Wordle, where players try to guess a hidden word within six attempts.</p>
        <p>It's simple yet addictive, combining logic, vocabulary, and deduction.</p>
        <p>The game supports different word lists and lengths in multiple languages. Currently, English and German are available.</p>
        <p>Want to see your language in the game? Feel free to send me a word list!</p>
    </description>
    <screenshots>
        <screenshot environment="gnome:light">
            <image type="source">https://codeberg.org/petsoi/words/raw/branch/main/data/resources/screenshots/main_light.png</image>
            <caption>Main Window</caption>
        </screenshot>
        <screenshot environment="gnome:dark">
            <image type="source">https://codeberg.org/petsoi/words/raw/branch/main/data/resources/screenshots/main_dark.png</image>
            <caption>Main Window</caption>
        </screenshot>
        <screenshot environment="gnome:light">
            <image type="source">https://codeberg.org/petsoi/words/raw/branch/main/data/resources/screenshots/gameover_light.png</image>
            <caption>Game Over</caption>
        </screenshot>
        <screenshot environment="gnome:light">
            <image type="source">https://codeberg.org/petsoi/words/raw/branch/main/data/resources/screenshots/statistics_light.png</image>
            <caption>Game Statisics</caption>
        </screenshot>
    </screenshots>
    <url type="homepage">https://codeberg.org/petsoi/words</url>
    <url type="bugtracker">https://codeberg.org/petsoi/words/issues</url>
    <!-- Source code repository -->
    <url type="vcs-browser">https://codeberg.org/petsoi/words</url>
    <!-- Translation repository -->
    <!-- <url type="translate">https://gitlab.gnome.org/bilelmoussaoui/words/-/tree/master/po</url> -->
    <!-- Open Age Ratings Service:
       https://hughsie.github.io/oars/generate.html
  -->
    <content_rating type="oars-1.1" />
    <recommends>
        <control>pointing</control>
        <control>touch</control>
        <control>keyboard</control>
        <control>tablet</control>
    </recommends>
    <categories>
        <category>Game</category>
    </categories>
    <requires>
        <display_length compare="ge">360</display_length>
    </requires>
    <keywords>
        <keyword>wordle</keyword>
    </keywords>
    <kudos>
        <!--
       GNOME Software kudos:
       https://gitlab.gnome.org/GNOME/gnome-software/-/blob/main/doc/kudos.md
     -->
        <kudo>ModernToolkit</kudo>
        <kudo>HiDpiIcon</kudo>
    </kudos>
    <!-- developer_name tag deprecated with Appstream 1.0 -->
    <developer_name translate="no">Peter Sonntag</developer_name>
    <!-- Introduced with Appstream 1.0, but not yet fully supported by corresponding projects -->
    <developer id="gnome.org">
        <name translate="no">Peter Sonntag</name>
    </developer>
    <url type="donation">https://paypal.me/KleinerOnkel</url>
    <!-- 
    Branding colors:
    https://docs.flathub.org/docs/for-app-authors/metainfo-guidelines/#brand-color
  -->
    <branding>
        <color type="primary" scheme_preference="light">#9C9C9C</color>
        <color type="primary" scheme_preference="dark">#5A5A5A</color>
    </branding>
    <update_contact>peter@sonniger-tag.eu</update_contact>
    <translation type="gettext">@gettext-package@</translation>
    <launchable type="desktop-id">@app-id@.desktop</launchable>
    <releases>
        <release version="0.4.2" date="2025-02-11">
            <description>
                <p>Fix Garman word list</p>
                <p>Remove word list 'English reduced"</p>
            </description>
        </release>
        <release version="0.4.1" date="2025-02-09">
            <description>
                <p>Fixes bug where game was not terminated properly.</p>
            </description>
        </release>
        <release version="0.4.0" date="2025-02-08">
            <description>
                <p>Add statistics.</p>
            </description>
        </release>
        <release version="0.3.5" date="2025-02-06">
            <description>
                <p>Add Ctrl+N short cut for new game.</p>
            </description>
        </release>
        <release version="0.3.4" date="2025-02-05">
            <description>
