                <ul>
                    <li>Give feedback if word is not in dictionary.</li>
                </ul>
            </description>
        </release>
        <release version="0.1.6" date="2025-01-24">
            <description>
                <p>Changes:</p>
                <ul>
                    <li>Fix colors of letters.</li>
                </ul>
            </description>
        </release>
        <release version="0.1.5" date="2025-01-24">
            <description>
                <p>Changes:</p>
                <ul>
                    <li>Improve keyboard navigation</li>
                </ul>
            </description>
        </release>
        <release version="0.1.4" date="2025-01-24">
            <description>
                <p>Changes:</p>
                <ul>
                    <li>Improve word list</li>
                </ul>
            </description>
        </release>
        <release version="0.1.3" date="2025-01-23">
            <description>
                <p>Changes:</p>
