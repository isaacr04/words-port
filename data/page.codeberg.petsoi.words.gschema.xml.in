<?xml version="1.0" encoding="utf-8"?>
<schemalist>
  <schema path="/page/codeberg/petsoi/words/" id="@app-id@" gettext-domain="@gettext-package@">
    <key name="window-width" type="i">
      <default>360</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>487</default>
      <summary>Window height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="game-name" type="s">
        <default>"English"</default>
        <summary>File name of the last selected word list</summary>
    </key>
    <key name="number-of-letters" type="u">
        <default>5</default>
        <summary>The number of letters of the last game</summary>
    </key>
  </schema>
</schemalist>
