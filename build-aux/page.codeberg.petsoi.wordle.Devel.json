{
    "id": "page.codeberg.petsoi.wordle.Devel",
    "runtime": "org.gnome.Platform",
    "runtime-version": "47",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm18"
    ],
    "command": "wordle",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "build-options": {
        "append-ld-library-path": "/usr/lib/sdk/llvm18/lib",
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "RUST_BACKTRACE": "1",
            "RUST_LOG": "test-project=debug"
        },
        "build-args": [
            "--share=network"
        ],
        "test-args": [
            "--socket=x11"
        ]
    },
    "modules": [
        {
            "name": "wordle",
            "buildsystem": "meson",
            "run-tests": true,
            "config-opts": [
                "-Dprofile=development"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://codeberg.org/petsoi/wordle",
                    "branch": "main"
                }
            ]
        }
    ]
}