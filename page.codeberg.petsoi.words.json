{
    "id": "page.codeberg.petsoi.words",
    "runtime": "org.gnome.Platform",
    "runtime-version": "47",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm18"
    ],
    "command": "words",
    "finish-args": [
        "--socket=fallback-x11",
        "--share=ipc",
        "--socket=wayland",
        "--device=dri"
    ],
    "build-options": {
        "append-ld-library-path": "/usr/lib/sdk/llvm18/lib",
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "RUST_BACKTRACE": "1",
            "RUST_LOG": "test-project=debug"
        },
        "build-args": [
            "--share=network"
        ],
        "test-args": [
            "--socket=x11"
        ]
    },
    "modules": [
        {
            "name": "words",
            "buildsystem": "meson",
            "run-tests": true,
            "config-opts": [
                "-Dprofile=development"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "./"
                }
            ]
        }
    ]
}